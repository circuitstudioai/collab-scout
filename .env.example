# Qloo hackathon API (never commit real keys)
# Guide: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# Force the labelled mock fallback even if a key is present.
# Live mode is used when QLOO_API_KEY is set and this is not true.
QLOO_USE_MOCK=false

# Gemini 2.5 Flash for taste-brief synthesis. If unset, a canned fallback is used.
GEMINI_API_KEY=

# Optional tuning
# QLOO_TIMEOUT_MS=15000
# QLOO_CACHE_TTL_MS=600000
# QLOO_MAX_RETRIES=2
