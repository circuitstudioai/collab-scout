# Qloo hackathon API (never commit real keys)
# Guide: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# Gemini 2.5 Flash for the real scout agent and Google-grounded research.
# Missing or invalid credentials leave research unavailable; no canned fallback.
# On Vercel: update Preview/Production values and redeploy.
GEMINI_API_KEY=

# Optional tuning
# QLOO_TIMEOUT_MS=15000
# QLOO_CACHE_TTL_MS=600000
# QLOO_MAX_RETRIES=2

# Server-only Vercel Marketplace Upstash Redis Free quota (Sensitive in Vercel).
# Use the REST HTTPS origin and write-capable REST token; never NEXT_PUBLIC_.
SITEBRIEF_REDIS_REST_URL=
SITEBRIEF_REDIS_REST_TOKEN=
# Provider pairs UPSTASH_REDIS_REST_URL/TOKEN or KV_REST_API_URL/TOKEN also work.
# Limit fixed at 50 / UTC day / environment. No environment override.
